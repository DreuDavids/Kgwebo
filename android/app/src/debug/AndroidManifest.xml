<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is also declared in the main manifest for production. Debug
         repeats it so the Flutter tool can talk to the running app (hot
         reload, breakpoints) even if manifests are inspected in isolation. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
</manifest>
